<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Example_Usage</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET" Version="2.23.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\C# Wrapper\GalensUnified.CubicGrid.Renderer.NET.csproj" />
    <ProjectReference Include="..\Cubic-Grid_Voxel_Core\Core\GalensUnified.CubicGrid.Core.csproj" />
  </ItemGroup>

  <Target Name="CompileShaders" BeforeTargets="Build">
    <Exec
      Condition="$([MSBuild]::IsOSPlatform('Linux')) Or $([MSBuild]::IsOSPlatform('OSX'))"
      WorkingDirectory=".."
      Command="./HLSLtoGLSL.sh"
      IgnoreExitCode="true"
      IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="ShaderExitCode" />
    </Exec>
    <Exec
      Condition="$([MSBuild]::IsOSPlatform('Windows'))"
      WorkingDirectory=".."
      Command="bash ./HLSLtoGLSL.sh"
      IgnoreExitCode="true"
      IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="ShaderExitCode" />
    </Exec>

    <Warning
      Condition="'$(ShaderExitCode)' == '3' Or '$(ShaderExitCode)' == '127' Or '$(ShaderExitCode)' == '9009'"
      Text="Shader regeneration skipped: dxc, spirv-cross or bash not found. Using the pregenerated GLSL in Assets/. Install them only if you edit HLSL." />

    <Error
      Condition="'$(ShaderExitCode)' != '0' And '$(ShaderExitCode)' != '3' And '$(ShaderExitCode)' != '127' And '$(ShaderExitCode)' != '9009'"
      Text="HLSL to GLSL translation failed (exit code $(ShaderExitCode))." />

    <ItemGroup Condition="'$(ShaderExitCode)' == '0'">
      <CompiledGlsl Include="../GLSL SpriV Translation/*.glsl" />
    </ItemGroup>

    <Copy
      Condition="'$(ShaderExitCode)' == '0'"
      SourceFiles="@(CompiledGlsl)"
      DestinationFolder="./Assets/GLSL SpriV Translation/"
      SkipUnchangedFiles="true" />

    <RemoveDir Directories="../GLSL SpriV Translation" />
  </Target>

  <Target Name="CopyAssets" AfterTargets="Build">
  <ItemGroup>
    <Assets Include=".\Assets\**\*.*" />
  </ItemGroup>

    <Copy
      SourceFiles="@(Assets)"
      DestinationFolder="$(OutDir)\Assets\%(RecursiveDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
